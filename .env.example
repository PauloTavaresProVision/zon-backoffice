# Copiar para .env e preencher. O .env nunca vai para o Git.

# --- Base de dados (PostgreSQL só do Zon Backoffice) ---
POSTGRES_DB=zon_backoffice
POSTGRES_USER=zon_backoffice
# Gerar com: openssl rand -hex 24
POSTGRES_PASSWORD=
DB_PORT=5450

# --- App ---
WEB_PORT=4620
APP_URL=http://127.0.0.1:4620
# Assina os links públicos das faturas. Gerar com: openssl rand -hex 32
APP_SECRET=
# true atrás de HTTPS; false só para testar em http://127.0.0.1
COOKIE_SECURE=true

# Primeiro administrador (só é criado se ainda não houver utilizadores)
ADMIN_EMAIL=
ADMIN_NAME=
# Mínimo 12 caracteres
ADMIN_PASSWORD=

# --- OfficeGest (conta da Zon) ---
# Ex.: https://<conta-da-zon>.officegest.com/api   (atenção: não usar a conta da TAAG)
OFFICEGEST_URL=
OFFICEGEST_USER=
OFFICEGEST_KEY=
# Artigo da mensalidade e taxa de IVA no OfficeGest (confirmar com a contabilidade)
OFFICEGEST_ARTICLE_ID=
OFFICEGEST_VAT_ID=
# NIF usado quando o cliente não tem NIF (confirmar com a contabilidade)
OFFICEGEST_CONSUMER_NIF=999999999
# Tipos de documento a trazer para a conta do cliente, e o tipo emitido após o pagamento
OFFICEGEST_DOC_TYPES=fr,ft,nc
OFFICEGEST_ISSUE_TYPE=fr
# Pagamentos a partir deste dia recebem fatura-recibo do backoffice (AAAA-MM-DD).
# Vazio = emissão desligada. Só ligar quando o sistema antigo deixar de emitir, para não haver faturas a dobrar.
OFFICEGEST_ISSUE_FROM=
OFFICEGEST_SYNC_MINUTES=60

# --- Ciclo de cobrança (IXC + AppyPay + WeSender) ---
# desligado: nada corre · simulacao: lê o IXC e mostra em Cobrança o que faria (sem referências, SMS nem baixas)
# ativo: cria referências, envia SMS, confirma pagamentos e dá baixa no IXC.
# ATENÇÃO: antes de pôr em "ativo", desligar as tarefas do sistema antigo, senão o cliente recebe referências a dobrar.
CYCLE_MODE=desligado
# Na passagem do sistema antigo: só os títulos que vencem a partir deste dia (AAAA-MM-DD) entram no ciclo.
# Os anteriores já têm referência do sistema antigo. Vazio = todos (até 30 dias em atraso).
CYCLE_FROM_DUE=

# IXC da Zon. Ex.: https://<servidor-ixc>/webservice/v1   Token: "<id do utilizador>:<token>" (Configurações > Usuários)
IXC_URL=
IXC_TOKEN=
IXC_SYNC_MINUTES=180

# AppyPay (referências Multicaixa). Credenciais da conta da Zon; pedir chaves novas à AppyPay.
APPYPAY_URL=
APPYPAY_TOKEN_URL=
APPYPAY_CLIENT_ID=
APPYPAY_CLIENT_SECRET=
APPYPAY_RESOURCE=
APPYPAY_PAYMENT_METHOD=
APPYPAY_ENTITY=11700
# Fica no URL do webhook a dar à AppyPay: <APP_URL>/api/appypay/webhook/<segredo>. Gerar com: openssl rand -hex 24
APPYPAY_WEBHOOK_SECRET=

# WeSender (SMS). Ex.: https://api.wesender.co.ao/envio/apikey
WESENDER_URL=
WESENDER_KEY=
# Com um telemóvel aqui, TODAS as SMS vão só para ele (testes na conta verdadeira). Vazio em produção.
SMS_TEST_PHONE=
# Linha "Dúvidas:" no fim das SMS (vazio = sem a linha)
SMS_SUPPORT_PHONE=

# --- Só desenvolvimento (docker compose --profile dev) ---
# Com o OfficeGest simulado: OFFICEGEST_URL=http://officegest-mock:4630/api, OFFICEGEST_USER=demo,
# OFFICEGEST_KEY=demo-key, OFFICEGEST_ARTICLE_ID=MENSALIDADE
# Com IXC, AppyPay e WeSender simulados (contentor integrations-mock):
#   IXC_URL=http://integrations-mock:4640/ixc/webservice/v1
#   APPYPAY_URL=http://integrations-mock:4640/appypay/v2.0/   APPYPAY_TOKEN_URL=http://integrations-mock:4640/appypay/token
#   WESENDER_URL=http://integrations-mock:4640/wesender/envio/apikey
#   DEV_MOCKS_URL=http://integrations-mock:4640   (ativa o botão "Simular pagamento")
#   e quaisquer valores inventados para os tokens e chaves (o simulado usa os mesmos do .env)
DEV_MOCKS_URL=
SEED_DEMO=false
SEED_OFFICEGEST_MOCK=false
SEED_INTEGRATIONS_MOCK=false
